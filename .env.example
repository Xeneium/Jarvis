# ==============================================================================
# OpenJarvis Environment Configuration & API Keys (Example Template)
# ==============================================================================
# Copy this file to .env and fill in your API keys as needed:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# ==============================================================================

# 0. Local Inference Engine (Ollama) & Exclusive Source Configuration
OPENJARVIS_DEFAULT_ENGINE=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
JARVIS_MODEL=gemma4:latest
JARVIS_SKIP_MODEL_PICK=1
JARVIS_SKIP_RUNTIME_PANEL=1
JARVIS_NUM_CTX=16384
JARVIS_NUM_GPU=1

# Exclusive Web Research Source: The Deep View (https://www.thedeepview.com)
OPENJARVIS_EXCLUSIVE_SOURCE=thedeepview
OPENJARVIS_WEB_SEARCH_ENGINE=deep_view

# 1. Primary LLM & Inference Providers
NIM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
MINIMAX_API_KEY=
ATLASCLOUD_API_KEY=

# 2. Local Engine Hosts (Optional)
# OLLAMA_HOST=http://localhost:11434
# VLLM_HOST=http://localhost:8000
# LMSTUDIO_HOST=http://localhost:1234
# SGLANG_HOST=http://localhost:30000

# 3. Speech, Voice & Audio (TTS / STT)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# 4. Web Search & Intelligence Tools
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPLY_API_KEY=
FIRECRAWL_API_KEY=
OPENWEATHERMAP_API_KEY=

# 5. Developer & Messaging Channels
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
